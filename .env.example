# Copier ce fichier en .env.local et renseigner les valeurs.
# Aucune de ces variables ne doit porter le préfixe NEXT_PUBLIC_ :
# elles sont lues uniquement côté serveur.

# Jeton d'accès Storyblok de type « preview » (Settings > Access Tokens).
# Sert à lire le contenu et à vérifier la signature de l'éditeur visuel.
#
# ATTENTION : Storyblok signe l'URL d'aperçu avec le PREMIER jeton preview de
# l'espace, pas avec le plus récent. Cette variable doit donc contenir le
# jeton avec lequel Storyblok signe, sinon /storyblok-preview répond 404.
# Pour remplacer un jeton (rotation) : créer le nouveau, supprimer l'ancien
# dans Storyblok (le nouveau devient alors le premier jeton preview et prend
# le relais pour la signature), puis mettre la nouvelle valeur ici et dans
# les variables d'environnement Vercel.
STORYBLOK_PREVIEW_TOKEN=

# Secret du webhook de revalidation : valeur aléatoire de votre choix
# (par exemple : openssl rand -hex 32). À reporter dans l'URL du webhook
# Storyblok : https://<domaine>/api/revalidate?secret=<valeur>
STORYBLOK_WEBHOOK_SECRET=

# --- Page d'envoi des vidéos (/admin/videos) ---------------------------------
# Mot de passe que la cliente saisit pour ouvrir la page.
ADMIN_VIDEOS_PASSWORD=
# Clé de signature du cookie de session : valeur aléatoire (openssl rand -hex 32).
# La changer (ou changer le mot de passe) déconnecte toutes les sessions.
ADMIN_SESSION_SECRET=

# --- Stockage des vidéos : Cloudflare R2 -------------------------------------
# Cloudflare > R2 > Manage API tokens : jeton « Object Read & Write » limité au bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Adresse publique du bucket, sans barre finale : https://pub-….r2.dev en test,
# https://videos.gilanselmi.com une fois le domaine branché. Les liens donnés à
# la cliente commencent par cette adresse.
VIDEOS_PUBLIC_BASE_URL=
# Tests locaux uniquement (faux R2) : remplace https://<compte>.r2.cloudflarestorage.com
# R2_ENDPOINT=
