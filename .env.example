# Copier ce fichier en .env.local et renseigner les valeurs.
# Aucune de ces variables ne doit porter le préfixe NEXT_PUBLIC_ :
# elles sont lues uniquement côté serveur.

# Jeton d'accès Storyblok de type « preview » (Settings > Access Tokens).
# Sert à lire le contenu et à vérifier la signature de l'éditeur visuel.
STORYBLOK_PREVIEW_TOKEN=

# Secret du webhook Storyblok (Settings > Webhooks > Webhook secret).
# Sert à vérifier l'en-tête webhook-signature de /api/revalidate.
STORYBLOK_WEBHOOK_SECRET=
